DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands on one server instantly
DISCORD_GUILD_ID=

# Daily 11am (DISPLAY_TIMEZONE) reminder in this channel for members missing picks
DISCORD_NUDGE_CHANNEL=bad-qb
DISCORD_NUDGE_HOUR=11

# Google Apps Script web app URL (Deploy → Web app)
SHEETS_WEBHOOK_URL=
# Same value as Script Properties → WEBHOOK_SECRET
SHEETS_WEBHOOK_SECRET=

# Used for the weekly message date and "today" sheet filter
DISPLAY_TIMEZONE=America/Chicago

# Sleeper league used for QB fantasy points (League of Villains)
SLEEPER_LEAGUE_ID=1322259662862581760
